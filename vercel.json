{
  "rewrites": [
    {
      "source": "/((?!api|assets|favicon|robots).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Pinterest|Embedly|Applebot|Redditbot|Outbrain|vkShare|Quora|ShowYouBot|W3C_Validator|Googlebot|bingbot|SkypeUriPreview|Iframely|Mastodon|Google-InspectionTool).*"
        }
      ],
      "destination": "/api/og-meta?path=/$1"
    },
    {
      "source": "/((?!api|assets|favicon|robots).*)",
      "destination": "/index.html"
    }
  ]
}
