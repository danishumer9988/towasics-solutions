{
  "rewrites": [
    {
      "source": "/((?!api/|robots\\.txt|sitemap\\.xml|.*\\.txt|.*\\.xml|assets/.*|favicon\\.png).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|TelegramBot|WhatsApp|Slackbot|Discordbot|Pinterest|Embedly|Applebot|Redditbot|Outbrain|vkShare|Quora|Googlebot|bingbot|SkypeUriPreview|Iframely|Mastodon|Google-InspectionTool).*"
        }
      ],
      "destination": "/api/og-meta?path=/$1"
    },
    {
      "source": "/((?!api/|robots\\.txt|sitemap\\.xml|.*\\.txt|.*\\.xml|assets/.*|favicon\\.png).*)",
      "destination": "/index.html"
    }
  ]
}